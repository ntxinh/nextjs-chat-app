# libSQL/Turso database URL (default: local file)
DATABASE_URL=file:./dev.db
# Auth token for remote Turso/libSQL (optional; not needed for local file)
DATABASE_AUTH_TOKEN=
# better-auth session secret — required in production (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-in-production
# Base URL better-auth uses for redirects
BETTER_AUTH_URL=http://localhost:3000
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Optional OTLP endpoint for OpenTelemetry export
OTEL_EXPORTER_OTLP_ENDPOINT=
