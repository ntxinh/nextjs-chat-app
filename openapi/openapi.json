                  "senderName",
                  "createdAt"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "enum": [
              "direct",
              "group"
            ],
            "type": "string"
          },
          "unreadCount": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "preview",
          "unreadCount",
